{
  "name": "GihaSmash DevContainer",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [3000],
  "postCreateCommand": "npm install -g serve",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": ["ritwickdey.LiveServer", "esbenp.prettier-vscode"]
    }
  }
}
